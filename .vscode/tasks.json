{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Tests",
      "type": "shell",
      "command": "npm.cmd test",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Coverage",
      "type": "shell",
      "command": "npm.cmd run test:coverage",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
